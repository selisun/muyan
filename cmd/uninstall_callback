#!/bin/bash
# 卸载后：停止删除容器；按 wizard/uninstall 的选择处理用户数据。
#   wizard_purge_data=keep（默认）：保留背景图/模板配置/端口探测结果，重装自动恢复
#   wizard_purge_data=purge      ：彻底删除 $TRIM_PKGVAR/proxy 全部数据
# fnOS 登录页为零侵入反代，容器一停即自动恢复原样，无系统文件残留。

docker stop muyan >/dev/null 2>&1
docker rm muyan >/dev/null 2>&1

if [ "${wizard_purge_data:-keep}" = "purge" ]; then
  # :? 防止 TRIM_PKGVAR 为空时误删根路径
  rm -rf "${TRIM_PKGVAR:?}/proxy"
fi

exit 0
